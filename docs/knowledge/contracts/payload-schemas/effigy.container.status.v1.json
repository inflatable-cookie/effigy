{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "effigy.container.status.v1 payload",
  "description": "Payload of `effigy container <name> status --json`: the chosen backend, its source and reason, the project identity, published ports, per-service health, and scoped fs_events relay status. `services` is always an array: empty when the runtime is observed stopped, never null.",
  "type": "object",
  "required": [
    "ok",
    "schema",
    "schema_version",
    "container",
    "project_name",
    "driver",
    "backend",
    "backend_source",
    "manifest_driver",
    "compose_file",
    "primary_service",
    "primary_service_exec_ready",
    "runtime_running",
    "health",
    "ports",
    "mounts",
    "media_mounts",
    "services",
    "shared_services",
    "warnings",
    "environment",
    "profile",
    "compose_ps",
    "detach_timeout_secs",
    "fs_events"
  ],
  "properties": {
    "ok": {"type": "boolean"},
    "container": {"type": "string"},
    "project_name": {"type": "string"},
    "driver": {"type": "string"},
    "backend": {"type": "string"},
    "backend_source": {"type": "string"},
    "manifest_driver": {"type": "string"},
    "compose_file": {"type": "string"},
    "primary_service": {"type": "string"},
    "primary_service_exec_ready": {"type": ["object", "null", "boolean"]},
    "runtime_running": {"type": ["boolean", "null"]},
    "health": {"type": ["object", "null"]},
    "ports": {"type": "array", "items": {"type": "string"}},
    "mounts": {"type": "array"},
    "media_mounts": {"type": "array"},
    "services": {"type": "array", "items": {"type": "object"}},
    "shared_services": {"type": "array"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "environment": {
      "type": "object",
      "required": ["backend"],
      "properties": {"backend": {"type": "object"}, "record": {"type": ["object", "null"]}}
    },
    "profile": {"type": ["string", "null"]},
    "compose_ps": {"type": ["object", "null"]},
    "detach_timeout_secs": {"type": "integer"},
    "fs_events": {
      "type": "object",
      "required": ["mode", "state", "reason", "owner", "pid", "targets"],
      "properties": {
        "mode": {"enum": ["auto", "on", "off"]},
        "state": {"enum": ["active", "reconnecting", "inactive", "noop", "interrupted", "unknown"]},
        "reason": {"type": "string"},
        "owner": {"type": ["string", "null"], "enum": ["session", "stack", null]},
        "pid": {"type": ["integer", "null"]},
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "container", "host", "guest"],
            "properties": {
              "service": {"type": "string"},
              "container": {"type": "string"},
              "host": {"type": "string"},
              "guest": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
