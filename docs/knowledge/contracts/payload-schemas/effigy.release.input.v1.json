{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "effigy.release.input.v1",
  "description": "The candidate a release task target, artifact task or verify task reads at $EFFIGY_RELEASE_INPUT (contract 054 §6).",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "run",
    "invocation",
    "stage",
    "source_commit",
    "candidate_commit",
    "identities",
    "artifacts",
    "target",
    "subject"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "effigy.release.input.v1" },
    "schema_version": { "const": 1 },
    "run": { "type": "string", "minLength": 1 },
    "invocation": { "type": "string", "minLength": 1 },
    "stage": {
      "enum": [
        "validate",
        "pre-gates",
        "prepare",
        "certify",
        "publish",
        "verify",
        "closeout"
      ]
    },
    "source_commit": { "type": ["string", "null"] },
    "candidate_commit": { "type": ["string", "null"] },
    "identities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "identity", "tag"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["semver", "digest", "source", "task"] },
          "identity": { "type": ["string", "null"] },
          "tag": { "type": ["string", "null"] }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "pattern", "files"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1 },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256", "bytes"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "bytes": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "target": { "type": ["string", "null"] },
    "subject": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["target", "artifact", "identity", "release"] },
        "name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
