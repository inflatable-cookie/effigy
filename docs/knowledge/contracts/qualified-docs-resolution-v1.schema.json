{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Effigy qualified docs resolution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "target", "selector", "manifests", "include_graph", "leaves", "named_source", "source_files", "source_directories", "local_link_existence", "effigy", "resource_authority"],
  "properties": {
    "schema": { "const": "effigy.docs.qualified.resolution.v1" },
    "version": { "const": 1 },
    "selector": { "const": "qa:docs" },
    "target": { "type": "string" },
    "manifests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bytes" } },
    "include_graph": { "type": "array" },
    "leaves": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/links" },
        { "$ref": "#/$defs/paths" },
        { "$ref": "#/$defs/retired" }
      ]
    },
    "named_source": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical", "evidence", "assets", "discovery_reads"],
      "properties": {
        "canonical": { "const": "/Users/tom/.agents/skills/northstar" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "discovery_reads": { "type": "array", "items": { "type": "object", "required": ["path", "exists", "canonical"], "properties": { "path": { "type": "string" }, "exists": { "type": "boolean" }, "canonical": { "type": ["string", "null"] } } } },
        "assets": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/input" } }
      }
    },
    "source_files": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "source_directories": { "type": "array", "items": { "type": "string" } },
    "local_link_existence": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "exists"],
      "properties": { "path": { "type": "string" }, "exists": { "type": "boolean" } }
    } },
    "effigy": { "$ref": "#/$defs/bytes" },
    "resource_authority": { "const": "unavailable-without-live-controller" }
  },
  "$defs": {
    "bytes": {
      "type": "object", "additionalProperties": false, "required": ["canonical", "bytes", "sha256"],
      "properties": { "canonical": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["canonical", "bytes", "sha256", "relative"],
      "properties": { "canonical": { "type": "string" }, "relative": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "links": { "type": "object", "required": ["task", "argv", "ast"], "properties": { "task": { "const": "qa:docs:links" }, "argv": { "const": ["effigy", "docs", "check", "links"] }, "ast": { "type": "object" } } },
    "paths": { "type": "object", "required": ["task", "argv", "ast"], "properties": { "task": { "const": "qa:docs:paths" }, "argv": { "type": "array", "minItems": 5, "items": { "type": "string" } }, "ast": { "type": "object" } } },
    "retired": { "type": "object", "required": ["task", "argv", "ast"], "properties": { "task": { "const": "qa:docs:retired" }, "argv": { "const": ["effigy", "skill", "run", "northstar/retired-concepts"] }, "ast": { "type": "object" } } }
  }
}
